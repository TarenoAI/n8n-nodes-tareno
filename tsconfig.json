{
    "compilerOptions": {
        "strict": true,
        "module": "commonjs",
        "target": "es2019",
        "lib": [
            "es2019"
        ],
        "declaration": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "moduleResolution": "node",
        "outDir": "./dist",
        "rootDir": ".",
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "nodes/**/*.ts",
        "credentials/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}